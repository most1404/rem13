<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded alarm notification. Android shows at most 3 native action buttons, so the remaining snooze
     choices (15 min, 30 min, 1 hour, other time) live here as tappable buttons with their own PendingIntents. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="6dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/alarm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />

    <TextView
        android:id="@+id/alarm_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/alarm_btn_15"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notif_button_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <TextView
            android:id="@+id/alarm_btn_30"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notif_button_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <TextView
            android:id="@+id/alarm_btn_60"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notif_button_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />

        <TextView
            android:id="@+id/alarm_btn_other"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/notif_button_bg"
            android:gravity="center"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification" />
    </LinearLayout>
</LinearLayout>
